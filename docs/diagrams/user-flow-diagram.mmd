flowchart LR
    Landing[Landing Page /]
    AuthPage[Auth Page /auth\nSign In + Sign Up]
    RegisterAction[Submit Registration\nwith role + location]
    LoginAction[Submit Login]
    AuthValid{Credentials valid?}
    RoleGate{Role after authentication}

    ReaderDash[Reader Dashboard\n/reader/dashboard]
    DeliveryDash[Delivery Dashboard\n/delivery/dashboard]
    AdminDash[Admin Dashboard\n/admin/dashboard]

    BrowseBooks[Browse Books\n/browse]
    BrowseOffers[Browse Offers\n/offers-browse]
    CreateOffer[Create Offer\n/offers-create]
    MyOffers[My Offers\n/my-offers]
    ExchangeCenter[Exchange Center\n/exchange-center]
    Profile[Profile\n/profile]
    NotifCenter[Notification Center\n/notification-center]

    SendRequest[Send Exchange Request]
    ReviewRequest{Incoming request pending?}
    RequestAccepted[Request Accepted\nOffers Reserved + Delivery Created]
    RequestRejected[Request Rejected]

    DeliveryAvailable[Delivery Available List\n/delivery/offers]
    AcceptDelivery[Accept Delivery Task]
    DeliveryPending[Pending Deliveries\n/delivery/pending]
    DeliveryMap[Delivery Map\n/delivery/location/{id}]
    StartPickup[Start First Pickup]
    BookPicked[Complete Second Pickup]
    CompleteDelivery[Mark Delivered]
    DeliveryDone[Completed Deliveries\n/delivery/completed]

    AdminBooks[Manage Books]
    AdminUsers[Manage Users]
    AdminOffers[Manage Offers]
    AdminExchanges[Manage Exchange Requests]
    AdminApprove[Approve Exchange]

    LoginError[Show Login Error\nStay on Auth Page]

    Landing --> AuthPage
    AuthPage --> RegisterAction
    AuthPage --> LoginAction
    RegisterAction --> AuthPage
    LoginAction --> AuthValid
    AuthValid -- No --> LoginError --> AuthPage
    AuthValid -- Yes --> RoleGate

    RoleGate -- BOOK_FRIEND --> ReaderDash
    RoleGate -- DELIVERY_PARTNER --> DeliveryDash
    RoleGate -- ADMIN --> AdminDash

    ReaderDash --> BrowseBooks
    ReaderDash --> BrowseOffers
    ReaderDash --> ExchangeCenter
    ReaderDash --> MyOffers
    ReaderDash --> Profile
    ReaderDash --> NotifCenter

    BrowseBooks --> CreateOffer
    CreateOffer --> BrowseOffers
    BrowseOffers --> SendRequest --> ExchangeCenter
    ExchangeCenter --> ReviewRequest
    ReviewRequest -- Accept --> RequestAccepted --> NotifCenter
    ReviewRequest -- Reject --> RequestRejected --> NotifCenter
    MyOffers --> BrowseOffers
    Profile --> ReaderDash

    DeliveryDash --> DeliveryAvailable --> AcceptDelivery --> DeliveryPending
    DeliveryPending --> DeliveryMap
    DeliveryPending --> StartPickup --> BookPicked --> CompleteDelivery --> DeliveryDone --> NotifCenter

    AdminDash --> AdminBooks
    AdminDash --> AdminUsers
    AdminDash --> AdminOffers
    AdminDash --> AdminExchanges --> AdminApprove
    AdminApprove --> NotifCenter
